<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_checklist_template_tree" model="ir.ui.view">
        <field name="name">purchase.checklist.template.tree</field>
        <field name="model">purchase.checklist.template</field>
        <field name="arch" type="xml">
            <list string="Checklist Templates">
                <field name="name"/>
                <field name="po_state"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_checklist_template_form" model="ir.ui.view">
        <field name="name">purchase.checklist.template.form</field>
        <field name="model">purchase.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="po_state"/>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="item_ids" required="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="assignee_id"/>
                                    <field name="is_mandatory"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">purchase.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_purchase_checklist_template"
              name="Checklist Templates"
              parent="purchase.menu_purchase_config"
              action="action_purchase_checklist_template"
              sequence="100"/>
</odoo>
